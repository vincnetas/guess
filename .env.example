# Public WebSocket port on the host (8091 is free on the home server).
PORT=8091

# Distortion mode: "mock" returns a fixed string instantly; "ollama" calls the
# local LLM; "openai" calls an OpenAI-compatible chat API (DeepSeek).
DISTORTION_MODE=mock
MOCK_DISTORTED=A completely different sentence with swapped words.

# DISTORTION_MODE=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# DISTORTION_MODE=openai  (DeepSeek is OpenAI-compatible)
DISTORTION_API_KEY=
DISTORTION_BASE_URL=https://api.deepseek.com
DISTORTION_MODEL=deepseek-chat

MIN_PLAYERS=2
MAX_PLAYERS=8

# The backend serves the static web client (../web) from the same port. This is
# set directly in docker-compose.yml (bind-mounted into the container); the
# web client is reachable at http://<host>:8091/.
